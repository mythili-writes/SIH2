# Every environment variable the IPsec VPN Security Analyser reads.
#
# All are optional: with none set, the full pipeline runs offline with the
# defaults in config.py. Copy this file to .env and fill in what you need.
#
# The code does not load .env by itself. Export the variables into your shell
# first, for example:
#     set -a; source .env; set +a
#     streamlit run frontend/app.py
#
# Never commit a real .env: it is listed in .gitignore.

# --- LLM explanations (ai_engine/explainer.py) ------------------------------

# Anthropic API key. When set (and offline mode is off), one Claude API call
# writes the plain-English explanation for each finding. When unset, or if the
# call fails, built-in rule-based explanations are used. Scores never use it.
ANTHROPIC_API_KEY=

# Claude model for those explanations. Default: config.LLM_DEFAULT_MODEL.
ANTHROPIC_MODEL=

# Set to 1 to force rule-based explanations even when a key is present.
# Same effect as `--offline` on the CLI or the dashboard's offline toggle.
AI_OFFLINE=

# --- Input limits (backend/parser.py, frontend/app.py) ----------------------

# Largest capture accepted, in megabytes. Default: 200.
# Keep .streamlit/config.toml's server.maxUploadSize at least this large.
IPSEC_MAX_CAPTURE_MB=

# Packets read before parsing stops; the analysis records the truncation.
# Default: 200000.
IPSEC_MAX_PACKETS=

# --- Logging (config.py) ----------------------------------------------------

# DEBUG, INFO, WARNING, ERROR or CRITICAL. Default: INFO.
# Logs go to stdout and to the rotating file logs/app.log (logging_setup.py).
IPSEC_LOG_LEVEL=
